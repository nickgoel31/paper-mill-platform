# ==============================================================================
# PaperMill ERP Environment Variables
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/papermill_erp?schema=public"

# Auth.js / NextAuth v5
AUTH_SECRET="super-secret-auth-key-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Cutting Stock Solver Service (Python FastAPI + OR-Tools)
SOLVER_SERVICE_URL="http://localhost:8000"

# AI Explanation Service (Anthropic Claude - plan explanations only)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# WhatsApp Cloud API (Meta Graph API)
WHATSAPP_API_TOKEN="your-whatsapp-cloud-api-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-whatsapp-business-account-id"

# Application Settings
NODE_ENV="development"
PORT=3000
