datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../apps/web/src/generated/prisma"
  runtime  = "workerd"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  ADMIN
  SALES
  PLANNER
  OPERATOR
  DISPATCH
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PLANNED
  IN_PRODUCTION
  PRODUCED
  DISPATCHED
  CANCELLED
}

enum OrderPriority {
  URGENT
  NORMAL
  STOCK
}

enum PaperType {
  NATURAL
  BY
}

// Reel/sheet size category, hardcoded per mill request (two sizes only).
enum PaperSize {
  BABY
  NORMAL
}

// The unit a width/length value was originally entered in. `widthInch` /
// `maxDeckleInch` etc. columns always stay canonical inches (every existing
// comparison, the deckle solver, and stock-to-order matching depend on that) —
// this only tags which unit the mill's own number came from, for display and
// exact "as entered" record-keeping.
enum LengthUnit {
  INCH
  CM
}

enum RunStatus {
  PLANNED
  RELEASED
  RUNNING
  COMPLETED
  CANCELLED
}

enum LoadStatus {
  DRAFT
  PLANNED
  LOADING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum StockStatus {
  AVAILABLE
  ALLOCATED
  DISPATCHED
}

enum TrimMode {
  BOTH_SIDES
  ONE_SIDE
}

enum PostProductionMode {
  AUTO_DISPATCH
  INVENTORY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  UPI
  OTHER
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// TENANT (Paper Mill) — every business row below belongs to exactly one Tenant.
// Platform staff (TWJ Labs) are Users with tenantId = null.
// -----------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  code      String   @unique
  gstin     String?
  address   String?
  city      String?
  state     String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  postProductionMode PostProductionMode @default(AUTO_DISPATCH)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  machines      Machine[]
  transporters  Transporter[]
  trucks        Truck[]
  stockPresets  StockPreset[]
  gsmWeightProfiles GsmWeightProfile[]
  orders        Order[]
  productionRuns ProductionRun[]
  loadBatches   LoadBatch[]
  dispatches    Dispatch[]
  invoices      Invoice[]
  stockItems    StockItem[]
  wastageLogs   WastageLog[]
  notifications WhatsAppNotification[]
  auditLogs     AuditLog[]
  settings      SystemSetting[]
  payments      Payment[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  tenantId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  // Audit and creator relations
  createdClients      Client[]
  createdMachines     Machine[]
  createdTransporters Transporter[]
  createdTrucks       Truck[]
  createdOrders       Order[]
  createdLoadBatches  LoadBatch[]
  createdRuns         ProductionRun[]
  createdWastageLogs  WastageLog[]
  createdDispatches   Dispatch[]
  createdInvoices     Invoice[]
  createdStockPresets StockPreset[]
  createdGsmWeightProfiles GsmWeightProfile[]
  auditLogs           AuditLog[]
  recordedPayments    Payment[]

  @@index([role])
  @@index([email])
  @@index([tenantId])
}

model Client {
  id             String    @id @default(cuid())
  tenantId       String?
  name           String
  code           String
  gstin          String?
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  pincode        String
  contactPerson  String?
  phone          String
  whatsappNumber String
  email          String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?

  tenant        Tenant?                 @relation(fields: [tenantId], references: [id])
  createdBy     User?                  @relation(fields: [createdById], references: [id])
  orders        Order[]
  invoices      Invoice[]
  notifications WhatsAppNotification[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@index([deletedAt])
  @@index([city, state])
  @@index([createdById])
}

model Machine {
  id            String    @id @default(cuid())
  tenantId      String?
  name          String
  code          String
  maxDeckleInch Decimal // e.g. 196.00
  minDeckleInch Decimal // minimum usable width for a run
  minTrimInch   Decimal // mandatory edge trim, e.g. 0.50
  maxTrimInch   Decimal // reject patterns above this, e.g. 6.00
  trimMode      TrimMode  @default(BOTH_SIDES) // trim split across both edges, or one edge only
  // Which unit the deckle/trim fields above were entered in (they always stay
  // canonical inches in storage — this only drives what the edit form shows).
  dimensionUnit LengthUnit @default(INCH)
  minGsm        Int
  maxGsm        Int
  speedMpm      Int? // metres per minute, for run time estimate
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?

  tenant         Tenant?          @relation(fields: [tenantId], references: [id])
  createdBy      User?           @relation(fields: [createdById], references: [id])
  productionRuns ProductionRun[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([deletedAt])
  @@index([isActive])
  @@index([createdById])
}

model Transporter {
  id          String    @id @default(cuid())
  tenantId    String?
  name        String
  phone       String
  gstin       String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  createdBy   User?       @relation(fields: [createdById], references: [id])
  trucks      Truck[]
  loadBatches LoadBatch[]

  @@index([tenantId])
  @@index([deletedAt])
  @@index([createdById])
}

model Truck {
  id                 String    @id @default(cuid())
  tenantId           String?
  registrationNumber String
  capacityKg         Int
  transporterId      String?
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?

  tenant      Tenant?       @relation(fields: [tenantId], references: [id])
  transporter User?       @relation(fields: [createdById], references: [id])
  owner       Transporter? @relation(fields: [transporterId], references: [id])
  loadBatches LoadBatch[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId])
  @@index([transporterId])
  @@index([deletedAt])
  @@index([createdById])
}

model Order {
  id           String        @id @default(cuid())
  tenantId     String?
  orderNumber  String
  clientId     String
  orderDate    DateTime      @default(now())
  deliveryDate DateTime?
  priority     OrderPriority @default(NORMAL)
  status       OrderStatus   @default(DRAFT)
  notes        String?
  otherNotes   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String?

  tenant          Tenant?           @relation(fields: [tenantId], references: [id])
  client          Client           @relation(fields: [clientId], references: [id])
  createdBy       User?            @relation(fields: [createdById], references: [id])
  items           OrderItem[]
  loadAssignments LoadBatchOrder[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([priority])
  @@index([orderDate])
  @@index([deliveryDate])
  @@index([createdById])
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  widthInch        Decimal
  // The value + unit exactly as the mill typed it (widthInch above is always the
  // canonical inch equivalent, used for every comparison and by the solver).
  enteredWidth     Decimal?
  enteredWidthUnit LengthUnit @default(INCH)
  gsm              Int
  paperType        PaperType @default(NATURAL) @map("paperKind")
  size             PaperSize @default(NORMAL) @map("paperSize")
  paperColour      String?
  numberOfReels    Int?
  remark           String?
  quantityKg       Decimal
  tolerancePercent Decimal @default(5.00)
  ratePerKg        Decimal?
  producedKg       Decimal @default(0)
  dispatchedKg     Decimal @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patternCuts  PatternCut[]
  stockItems   StockItem[]
  invoiceLines InvoiceLine[]

  @@index([gsm, widthInch])
  @@index([orderId])
}

model LoadBatch {
  id                  String     @id @default(cuid())
  tenantId            String?
  batchNumber         String
  truckId             String?
  transporterId       String?
  driverName          String?
  driverPhone         String?
  status              LoadStatus @default(DRAFT)
  plannedDispatchDate DateTime?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  totalPlannedKg      Decimal    @default(0)
  notes               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  createdById         String?

  tenant        Tenant?                 @relation(fields: [tenantId], references: [id])
  truck         Truck?                 @relation(fields: [truckId], references: [id])
  transporter   Transporter?           @relation(fields: [transporterId], references: [id])
  createdBy     User?                  @relation(fields: [createdById], references: [id])
  orders        LoadBatchOrder[]
  invoice       Invoice?
  notifications WhatsAppNotification[]
  dispatch      Dispatch?

  @@unique([tenantId, batchNumber])
  @@index([tenantId])
  @@index([truckId])
  @@index([transporterId])
  @@index([status])
  @@index([plannedDispatchDate])
  @@index([createdById])
}

model LoadBatchOrder {
  id          String   @id @default(cuid())
  loadBatchId String
  orderId     String
  createdAt   DateTime @default(now())

  loadBatch LoadBatch @relation(fields: [loadBatchId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([loadBatchId, orderId])
  @@index([loadBatchId])
  @@index([orderId])
}

model ProductionRun {
  id               String    @id @default(cuid())
  tenantId         String?
  runNumber        String
  machineId        String
  gsm              Int
  status           RunStatus @default(PLANNED)
  plannedDate      DateTime  @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  totalTrimPercent Decimal?
  totalPlannedKg   Decimal   @default(0)
  totalActualKg    Decimal   @default(0)
  operatorFeedback String?   // free-text note left by the floor operator on completion
  solverPayload    Json?
  aiExplanation    String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?

  tenant      Tenant?           @relation(fields: [tenantId], references: [id])
  machine     Machine          @relation(fields: [machineId], references: [id])
  createdBy   User?            @relation(fields: [createdById], references: [id])
  patterns    CuttingPattern[]
  stockItems  StockItem[]
  wastageLogs WastageLog[]

  @@unique([tenantId, runNumber])
  @@index([tenantId])
  @@index([machineId])
  @@index([gsm])
  @@index([status])
  @@index([plannedDate])
  @@index([createdById])
}

model CuttingPattern {
  id               String   @id @default(cuid())
  productionRunId  String
  sequence         Int
  repetitions          Int
  completedRepetitions Int      @default(0)
  runLengthM           Float    @default(0)  // Exact run length in meters from solver (source of truth for weight calc)
  usedWidthInch        Decimal
  trimWidthInch        Decimal
  trimPercent          Decimal
  estimatedKg          Decimal
  actualKg             Decimal  @default(0)
  isManuallyEdited     Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  productionRun ProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  cuts          PatternCut[]
  wastageLogs   WastageLog[]

  @@index([productionRunId])
  @@index([sequence])
}

model PatternCut {
  id               String   @id @default(cuid())
  cuttingPatternId String
  orderItemId      String?
  stockPresetId    String?
  widthInch        Decimal
  count            Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cuttingPattern CuttingPattern @relation(fields: [cuttingPatternId], references: [id], onDelete: Cascade)
  orderItem      OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  stockPreset    StockPreset?   @relation(fields: [stockPresetId], references: [id], onDelete: SetNull)

  @@index([cuttingPatternId])
  @@index([orderItemId])
  @@index([stockPresetId])
}

model StockItem {
  id              String      @id @default(cuid())
  tenantId        String?
  orderItemId     String?
  productionRunId String?
  originOrderItemId String?
  // Human-facing reel identifier, e.g. "REEL-2609-0001". Monthly-reset, same
  // convention as Order.orderNumber.
  reelNumber      String?
  widthInch       Decimal
  gsm             Int
  paperType       PaperType   @default(NATURAL) @map("paperKind")
  size            PaperSize   @default(NORMAL) @map("paperSize")
  enteredWidth    Decimal?
  enteredWidthUnit LengthUnit @default(INCH)
  quantityKg      Decimal
  status          StockStatus @default(AVAILABLE)
  location        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant        Tenant?         @relation(fields: [tenantId], references: [id])
  orderItem     OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  productionRun ProductionRun? @relation(fields: [productionRunId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([gsm, widthInch])
  @@index([orderItemId])
  @@index([originOrderItemId])
  @@index([productionRunId])
}

model WastageLog {
  id               String   @id @default(cuid())
  tenantId         String?
  productionRunId  String?
  cuttingPatternId String?
  wastageKg        Decimal
  wastageType      String // "TRIM" | "REJECT" | "OTHER"
  reason           String?
  recordedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?

  tenant         Tenant?          @relation(fields: [tenantId], references: [id])
  productionRun  ProductionRun?  @relation(fields: [productionRunId], references: [id], onDelete: SetNull)
  cuttingPattern CuttingPattern? @relation(fields: [cuttingPatternId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation(fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([productionRunId])
  @@index([cuttingPatternId])
  @@index([recordedAt])
  @@index([wastageType])
  @@index([createdById])
}

model Dispatch {
  id                String   @id @default(cuid())
  tenantId          String?
  dispatchNumber    String
  loadBatchId       String   @unique
  dispatchedAt      DateTime @default(now())
  gatePassNumber    String?
  vehicleNumber     String
  driverName        String
  driverPhone       String
  totalDispatchedKg Decimal
  remarks           String?
  // Export/logistics document fields (consignee may differ from the buyer/client).
  consigneeName    String?
  consigneeAddress String?
  voucherNumber    String?
  termsOfPayment   String?
  termsOfDelivery  String?
  dispatchThrough  String?
  destination      String?
  vesselFlightNo   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?

  tenant    Tenant?    @relation(fields: [tenantId], references: [id])
  loadBatch LoadBatch @relation(fields: [loadBatchId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])
  invoices  Invoice[]

  @@unique([tenantId, dispatchNumber])
  @@index([tenantId])
  @@index([dispatchedAt])
  @@index([createdById])
}

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String?
  invoiceNumber String
  clientId      String
  loadBatchId   String?       @unique
  dispatchId    String?
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Decimal
  cgst          Decimal       @default(0)
  sgst          Decimal       @default(0)
  igst          Decimal       @default(0)
  totalAmount   Decimal
  status        InvoiceStatus @default(DRAFT)
  pdfUrl        String?
  irn           String?
  ackNumber     String?
  ackDate       DateTime?
  qrCodeData    String?
  einvoiceStatus String       @default("NOT_GENERATED")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String?

  payments    Payment[]
  tenant      Tenant?        @relation(fields: [tenantId], references: [id])
  client      Client        @relation(fields: [clientId], references: [id])
  loadBatch   LoadBatch?    @relation(fields: [loadBatchId], references: [id])
  dispatch    Dispatch?     @relation(fields: [dispatchId], references: [id])
  createdBy   User?         @relation(fields: [createdById], references: [id])
  lines       InvoiceLine[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([invoiceDate])
  @@index([status])
  @@index([dispatchId])
  @@index([createdById])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  orderItemId String?
  description String
  hsnCode     String   @default("4804")
  quantityKg  Decimal
  ratePerKg   Decimal
  amount      Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([orderItemId])
}

model Payment {
  id              String        @id @default(cuid())
  tenantId        String?
  invoiceId       String
  amount          Decimal
  paymentDate     DateTime      @default(now())
  method          PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  notes           String?
  recordedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([tenantId])
}

model WhatsAppNotification {
  id                String             @id @default(cuid())
  tenantId          String?
  loadBatchId       String?
  clientId          String
  phoneNumber       String
  templateName      String
  payload           Json
  status            NotificationStatus @default(QUEUED)
  providerMessageId String?
  errorMessage      String?
  attempts          Int                @default(0)
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant    Tenant?     @relation(fields: [tenantId], references: [id])
  loadBatch LoadBatch? @relation(fields: [loadBatchId], references: [id], onDelete: SetNull)
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([clientId])
  @@index([loadBatchId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  tenantId    String?
  key         String
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
}

// Per-mill calibration: how many kg a standard finished reel weighs per inch of
// width, for a given GSM — mills keep this precisely because a fixed maximum
// reel/roll diameter (winder limit) means different GSMs wind to different
// lengths, so weight-per-inch doesn't scale linearly with GSM. Used by the
// deckle planner to estimate/validate cut weight without needing an exact run
// length up front. `reelDiameterInch` is informational (shown to operators).
model GsmWeightProfile {
  id               String   @id @default(cuid())
  tenantId         String?
  gsm              Int
  kgPerInch        Decimal
  reelDiameterInch Decimal?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?

  tenant    Tenant? @relation(fields: [tenantId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@unique([tenantId, gsm])
  @@index([tenantId])
}

model StockPreset {
  id               String    @id @default(cuid())
  tenantId         String?
  name             String
  code             String
  widthInch        Decimal
  dimensionUnit    LengthUnit @default(INCH)
  gsm              Int
  standardWeightKg Decimal
  defaultLocation  String?   @default("BAY-A (Primary Warehouse)")
  shade            String?   @default("NATURAL")
  bf               String?   @default("18BF")
  paperType        String?   @default("KRAFT")
  description      String?
  isActive         Boolean   @default(true)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?

  tenant           Tenant?        @relation(fields: [tenantId], references: [id])
  createdBy        User?         @relation(fields: [createdById], references: [id])
  patternCuts      PatternCut[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([gsm, widthInch])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdById])
}

